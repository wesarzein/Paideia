# Template only. Store the completed file outside Git; do not use example values.
COMPOSE_PROJECT_NAME=paideia-integration
PAIDEIA_ENV_FILE=config/local/production.env
ENVIRONMENT=production
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=18080
POSTGRES_DB=paideia_production
POSTGRES_USER=paideia_service
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://paideia_service:REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD@postgres:5432/paideia_production
JWT_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BACKEND_CORS_ORIGINS=https://school.example.invalid
# Only for explicit initial provisioning, then remove from the private file:
# INITIAL_ADMIN_EMAIL=admin@your-school.example
# INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
ALLOW_SYNTHETIC_SEED=false
TZ=America/Lima
